x; margin-top: 22px; }\n  .avatar {\n    flex: 0 0 auto; width: 96px; height: 96px;\n    border-radius: 50%; object-fit: cover; display: block;\n    border: 1px solid #e6e6ec; background: #f4f4f7;\n  }\n  .who { flex: 1 1 auto; min-width: 0; padding-top: 3px; }\n  .name {\n    font-size: 26px; line-height: 1.25; font-weight: 700; letter-spacing: .01em; color: #17171c;\n    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;\n  }\n  .title {\n    margin-top: 9px;\n    font-size: 16px; line-height: 1.55; color: #5c5c68;\n    overflow-wrap: anywhere; word-break: break-word;\n    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;\n    overflow: hidden; max-height: 50px;\n  }\n\n  .meta { display: flex; align-items: center; flex-wrap: wrap; gap: 16px; margin-top: 18px; }\n  .tag {\n    display: inline-flex; align-items: center; padding: 3px 10px;\n    border: 1px solid #e6e6ec; border-radius: 4px;\n    font-size: 12px; letter-spacing: .04em; color: #6b6b78; background: #fafafc;\n  }\n  .stat { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; color: #6b6b78; }\n  .stat::before { content: \"\"; width: 6px; height: 6px; border-radius: 50%; background: #fb7299; }\n  .tag:empty, .stat:empty { display: none; }\n\n  /* 开播时间：空字符串时整块隐藏，不留空白 */\n  .live-time {\n    position: relative; display: inline-flex; align-items: center;\n    margin-top: 14px; padding: 2px 0 2px 15px;\n    font-size: 13px; color: #4a4a55; border-left: 2px solid #fb7299;\n  }\n  .live-time:empty { display: none; }\n\n  .foot {\n    display: flex; align-items: center; justify-content: space-between;\n    margin-top: 18px; padding-top: 12px;\n    border-top: 1px solid #f0f0f4;\n  }\n  .room { font-size: 12px; letter-spacing: .08em; color: #9a9aa8; }\n  .room:empty { display: none; }\n  .mark { display: inline-flex; align-items: center; gap: 6px; }\n  .mark i { display: block; width: 5px; height: 5px; border-radius: 50%; background: #e0e0e6; }\n  .mark i:nth-child(3) { background: #fb7299; }\n</style>\n</head>\n<body>\n  <div class=\"card\">\n    <div class=\"inner\">\n      <div class=\"topbar\">\n        <span class=\"brand\">Bilibili Live</span>\n      </div>\n\n      <div class=\"cover-wrap\">\n        <img class=\"cover\" src=\"data:image/svg+xml;base64,\" alt=\"\">\n        <span class=\"cover-shade\"></span>\n        <span class=\"status\">开播了</span>\n      </div>\n\n      <div class=\"profile\">\n        <img class=\"avatar\" src=\"data:image/svg+xml;base64,\" alt=\"\">\n        <div class=\"who\">\n          <div class=\"name\">演示主播</div>\n          <div class=\"title\">一起认识新的插件面板</div>\n        </div>\n      </div>\n\n      <div class=\"meta\"><span class=\"tag\">知识分享</span><span class=\"stat\">120人气</span></div>\n\n      <div class=\"live-time\"></div>\n\n      <div class=\"foot\">\n        <span class=\"room\">房间 610001</span>\n        <span class=\"mark\"><i></i><i></i><i></i></span>\n      </div>\n    </div>\n  </div>\n</body>\n</html>\n",
